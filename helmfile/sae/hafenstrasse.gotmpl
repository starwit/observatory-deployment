repositories:
  - name: starwitorg
    url: registry-1.docker.io/starwitorg
    oci: true

environments:
  default:
    values:
      - cameras:
          northwest:
            username: admin
            passwordRef: ref+bw://fd05c0ee-c36f-466e-889d-b4a200f4816c/password
          southwest:
            username: admin
            passwordRef: ref+bw://4a95e20b-7dac-4981-a989-b4a200f4362d/password
          southeast:
            username: admin
            passwordRef: ref+bw://747241ed-b4ca-4c32-a8b1-b4a200f44e82/password
          northeast:
            username: admin
            passwordRef: ref+bw://6e6a0b09-c978-4990-9aa3-b4a200f41c68/password

---

releases:
  - name: sae
    chart: starwitorg/sae
    version: 11.3.0
    namespace: sae
    createNamespace: true
    values:
      - intelGpuDriver: xe

        positionSource:
          enabled: true
          settingsYaml:
            log_level: INFO
            position_source:
              type: static
              lat: 52.42404694410418
              lon: 10.71719800380943
        
        geoMapper:
          settingsYaml:
            cameras:
            - brown_distortion_k1: -0.3205775683423553
              brown_distortion_k2: 0.06835772189745826
              brown_distortion_k3: 0
              mode: map
              elevation_m: 9.750873463000419
              heading_deg: 83.28665708786522
              image_height_px: 720
              image_width_px: 1280
              remove_unmapped_detections: false
              roll_deg: 1.451322047263786
              stream_id: hafenstrasse-southeast
              tilt_deg: 34.89977815983701
              view_x_deg: 98
            - brown_distortion_k1: -0.2836159635730888
              brown_distortion_k2: 0.0438144175007354
              brown_distortion_k3: 0
              elevation_m: 9.837664481459656
              heading_deg: 10.860781123214302
              image_height_px: 720
              image_width_px: 1280
              mode: map
              remove_unmapped_detections: false
              roll_deg: -2.8153535849970908
              stream_id: hafenstrasse-northwest
              tilt_deg: 60.23730868825839
              view_x_deg: 78
            - brown_distortion_k1: -0.3642591635887667
              brown_distortion_k2: 0.13690304367204442
              brown_distortion_k3: 0
              elevation_m: 10.239907398141582
              heading_deg: 192.25415424271873
              image_height_px: 720
              image_width_px: 1280
              mode: map
              remove_unmapped_detections: false
              roll_deg: -2.349038854591525
              stream_id: hafenstrasse-southwest
              tilt_deg: 42.880596818964804
              view_x_deg: 97.5
            - brown_distortion_k1: -0.18669333449908376
              brown_distortion_k2: 0.023470466423026186
              brown_distortion_k3: 0
              elevation_m: 9.741087240333819
              heading_deg: 311.48840848469496
              image_height_px: 720
              image_width_px: 1280
              mode: map
              remove_unmapped_detections: false
              roll_deg: -10.142669800887898
              stream_id: hafenstrasse-northeast
              tilt_deg: 34.560425395037896
              view_x_deg: 104.5
            object_center_elevation_m: 1
          enabled: true

        objectDetector:
          customWeights:
            enabled: true
            imageTag: yolov8m-openvino-static-736x1280
          restart:
            enabled: true
            schedule: "0 0 * * *" 
          settingsYaml:
            log_level: DEBUG
            drop_edge_detections: true
            model:
              device: intel:gpu
              nms_agnostic: true
              weights_path: custom_weights/yolov8m_openvino_model
              inference_size: [ 736, 1280 ]
              classes: [ 2, 5, 7 ]
            redis:
              stream_ids:
              - hafenstrasse-northwest
              - hafenstrasse-southwest
              - hafenstrasse-southeast
              - hafenstrasse-northeast

        objectTracker:
          settingsYaml:
            log_level: INFO
            tracker_algorithm: OCSORT
            tracker_config:
              Q_s_scaling: 1
              Q_xy_scaling: 1
              asso_func: iou
              asso_threshold: 0.3
              delta_t: 3
              det_thresh: 0.2
              inertia: 0.2
              max_age: 30
              min_hits: 3
              use_byte: false
          needsGpu: false
          streamIds:
          - hafenstrasse-northwest
          - hafenstrasse-southwest
          - hafenstrasse-southeast
          - hafenstrasse-northeast

        redisWriter:
          enabled: true
          instances:
          - name: prod
            settingsYaml:
              target_redis:
                buffer_length: 1000
                host: 100.72.130.57
                port: 30379
                target_stream_maxlen: 1000
                tls: false
              mapping_config:
                - source: geomapper:hafenstrasse-northwest
                - source: geomapper:hafenstrasse-southwest
                - source: geomapper:hafenstrasse-southeast
                - source: geomapper:hafenstrasse-northeast

        videoSource:
          settingsYamls:
          - id: hafenstrasse-northwest
            log_level: DEBUG
            jpeg_quality: 95
            max_fps: 8
            scale_width: 1280
            uri: 'rtsp://{{ .Values.cameras.northwest.username | urlquery }}:{{ .Values.cameras.northwest.passwordRef | fetchSecretValue | urlquery }}@192.168.1.11:8554/Streaming/channels/1'
            camera_position_source:
              stream_id: "positionsource:self"
              drop_frames_if_no_position: True
          - id: hafenstrasse-southwest
            log_level: DEBUG
            jpeg_quality: 95
            max_fps: 8
            scale_width: 1280
            uri: 'rtsp://{{ .Values.cameras.southwest.username | urlquery }}:{{ .Values.cameras.southwest.passwordRef | fetchSecretValue | urlquery }}@192.168.1.12:8554/Streaming/channels/1'
            camera_position_source:
              stream_id: "positionsource:self"
              drop_frames_if_no_position: True
          - id: hafenstrasse-southeast
            log_level: DEBUG
            jpeg_quality: 95
            max_fps: 8
            scale_width: 1280
            uri: 'rtsp://{{ .Values.cameras.southeast.username | urlquery }}:{{ .Values.cameras.southeast.passwordRef | fetchSecretValue | urlquery }}@192.168.1.13:8554/Streaming/channels/1'
            camera_position_source:
              stream_id: "positionsource:self"
              drop_frames_if_no_position: True
          - id: hafenstrasse-northeast
            log_level: DEBUG
            jpeg_quality: 95
            max_fps: 8
            scale_width: 1280
            uri: 'rtsp://{{ .Values.cameras.northeast.username | urlquery }}:{{ .Values.cameras.northeast.passwordRef | fetchSecretValue | urlquery }}@192.168.1.14:8554/Streaming/channels/1'
            camera_position_source:
              stream_id: "positionsource:self"
              drop_frames_if_no_position: True